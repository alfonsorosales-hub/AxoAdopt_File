%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 644d1d16821d08c44adb4d84e415ea37, type: 3}
  m_Name: PreguntasDatabase
  m_EditorClassIdentifier: Assembly-CSharp::PreguntasDatabase
  adoptantesPreguntas:
  - idAdoptante: 01
    viveSolo: 0
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "Pues, parte del d\xEDa estamos trabajando"
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: Si, hemos tenido perros antes
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Aunque el patio es peque\xF1o, creemos que le gustar\xE1"
      esEspecial: 0
  - idAdoptante: 02
    viveSolo: 0
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "Pasamos m\xE1s tiempo en casa que afuera"
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: Hemos cuidado animales antes
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: Nuestra casa tiene un patio amplio, apto para que se divierta
      esEspecial: 0
  - idAdoptante: 03
    viveSolo: 1
    preguntas:
    - enunciadoPregunta: "\xBFAl vivir solo/a, cu\xE1nto tiempo sueles tener disponible
        durante el d\xEDa para cuidar al animal?"
      respuestaNPC: Respuesta P1 del Adoptante 3
      esEspecial: 0
    - enunciadoPregunta: "\xBFHas tenido antes un animal con necesidades similares
        haci\xE9ndote cargo t\xFA solo/a?"
      respuestaNPC: Respuesta P2 del Adoptante 3
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal siendo
        tu residencia \xFAnica?"
      respuestaNPC: Respuesta P3 del Adoptante 3
      esEspecial: 0
