%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 644d1d16821d08c44adb4d84e415ea37, type: 3}
  m_Name: PreguntasDatabase
  m_EditorClassIdentifier: Assembly-CSharp::PreguntasDatabase
  adoptantesPreguntas:
  - idAdoptante: 01
    etiquetaEditor: Adoptante NPC #1 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "No mucho, puesto que pasamos medio d\xEDa fuera de casa."
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: Si, tuvimos varios perros antes
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Pues, nuestro patio es peque\xF1o, pero podr\xE1 ser c\xF3modo
        para el animal"
      esEspecial: 0
  - idAdoptante: 02
    etiquetaEditor: Adoptante NPC #2 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: Pues, Mientras nuestra hija va a la escuela, nosotros cuidamos
        la casa
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: Si, ya hemos cuidado animales anteriormente
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "El patio de nuestra casa es grande, perfecto para que nuestra
        hija y el beb\xE9 jueguen"
      esEspecial: 0
  - idAdoptante: 03
    etiquetaEditor: Adoptante NPC #3 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suele tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "Yo trabajo desde casa, as\xED que no tendr\xE9 problema alguno"
      esEspecial: 0
    - enunciadoPregunta: "\xBFHa tenido antes un animal con necesidades similares?"
      respuestaNPC: Ya he tenido gatos antes
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Mi departamento no es muy grande ni muy peque\xF1o, ojal\xE1
        se acomode bien"
      esEspecial: 0
  - idAdoptante: 04
    etiquetaEditor: Adoptante NPC #4 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "Mi esposa trabaja como ni\xF1era, yo estoy desempleado, as\xED
        que tenemos mucho tiempo"
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: "Ya hemos cuidado gatos antes. As\xED que ya sabemos como cuidarlos"
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: Nuestro hogar es grande, perfecto para la comodidad de todos
      esEspecial: 0
  - idAdoptante: 05
    etiquetaEditor: Adoptante NPC #5 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "No mucho. Con mi pareja de vez en cuando pasamos el d\xEDa fuera
        de casa"
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: "Pues, nos enfocamos m\xE1s en el tipo de cuidados que requiere
        el animal."
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Tenemos ya una habitaci\xF3n disponible para el animal. Ya queremos
        que lo vea"
      esEspecial: 0
  - idAdoptante: 06
    etiquetaEditor: Adoptante NPC #6 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: Mucho, ya que mi hermano y yo no salimos frecuentemente de nuestro
        hogar
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: "Aprendimos del cuidado de animales peque\xF1os gracias a nuestros
        padres"
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: Nuestra casa es lo suficientemente grande para que el animal
        pueda jugar
      esEspecial: 0
  - idAdoptante: 07
    etiquetaEditor: Adoptante NPC #7 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: Nosotros solo nos movemos por el terreno de nuestro hermoso campo
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: "Los animales que ya tenemos estar\xEDan orgullosos de ver a
        un nuevo integrante en la familia"
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Vivir en la zona rural de la ciudad es c\xF3mo. Adem\xE1s, el
        terreno es grande y perfecto para el animal"
      esEspecial: 0
  - idAdoptante: 08
    etiquetaEditor: Adoptante NPC #8 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "Prefeririamos quedarnos en nuestra casa m\xE1s que salir"
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: Si, ya hemos cuidado animales antes
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Nuestra casa es grande y c\xF3moda para el animal"
      esEspecial: 0
  - idAdoptante: 09
    etiquetaEditor: Adoptante NPC #9 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suele tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: Esta es la primera vez que salgo de mi departamento
      esEspecial: 0
    - enunciadoPregunta: "\xBFHa tenido antes un animal con necesidades similares?"
      respuestaNPC: "He tenido animales peque\xF1os antes"
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Por donde vivo es muy tranquilo, as\xED que mi departamento
        es adecuado para el animal"
      esEspecial: 0
  - idAdoptante: 10
    etiquetaEditor: Adoptante NPC #10 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "Mientras nuestro hijo est\xE1 en la escuela, nosotros pasamos
        medio dia en el trabajo"
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: "Pues, no mucho, ya que se nos hace algo dificil cuidar a animales
        peque\xF1os"
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Nuestro patio es acogedor, asi que creemos que le gustar\xE1"
      esEspecial: 0
  - idAdoptante: 11
    etiquetaEditor: Adoptante NPC #11 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "Mi hermana y yo as\xFAn estamos buscando empleo"
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: "Desde peque\xF1as que hemos cuidado roedores, como si fueran
        nuestros hermanitos"
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Vivimos en un departamento. No es mucho, pero sabemos que puede
        ser c\xF3modo"
      esEspecial: 0
  - idAdoptante: 12
    etiquetaEditor: Adoptante NPC #12 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "Pues, pasamos m\xE1s tiempo en nuestros trabajos que en casa"
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: "No, ser\xEDa nuestra primera vez cuidando un animal"
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Nuestro departamento es peque\xF1o, eso puede ser un problema"
      esEspecial: 0
  - idAdoptante: 13
    etiquetaEditor: Adoptante NPC #13 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: Desde que nos jubilamos que nuestros hijos nos ayudan monetariamente
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: Si, ya hemos cuidado aves antes. Obviamente hablo de mis hijos
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Nuestra casa es c\xF3moda y nuestro patio es agradable"
      esEspecial: 0
  - idAdoptante: 14
    etiquetaEditor: Adoptante NPC #14 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "No pasamos todo el d\xEDa fuera de casa, adem\xE1s nuestros
        hijos pasan algunas horas con sus abuelos de vez en cuando"
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: Si. Hemos tenido aves antes
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: Tenemos un patio no tangrande, pero bien protegido
      esEspecial: 0
  - idAdoptante: 15
    etiquetaEditor: Adoptante NPC #15 (3 Preguntas)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "Nos la pasamos m\xE1s tiempo cultivando en nuestro campo que
        salir a la gran ciudad"
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: Por su puesto. Nadie cuida animales de campo mejor que nosotros
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Nuestra parcela en el campo en c\xF3moda y amplia. Perfecta
        para cualquiera"
      esEspecial: 0
  - idAdoptante: 16
    etiquetaEditor: Adoptante NPC #16 (4 Preguntas - Especial)
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "Pues si, pasamos m\xE1s tiempo en casa que afuera"
