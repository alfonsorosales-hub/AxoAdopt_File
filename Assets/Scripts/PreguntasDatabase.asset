  m_Script: {fileID: 11500000, guid: 644d1d16821d08c44adb4d84e415ea37, type: 3}
  m_Name: PreguntasDatabase
  m_EditorClassIdentifier: Assembly-CSharp::PreguntasDatabase
  adoptantesPreguntas:
  - idAdoptante: 01
    viveSolo: 0
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: "Como familia tenemos un tiempo medio disponible. Nos organizamos
        entre nosotros para cubrir lo necesario durante el d\xEDa."
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: "S\xED, anteriormente hemos tenido perros en la familia, as\xED
        que conocemos bien sus din\xE1micas."
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: "Vivimos en una casa acogedora con un patio peque\xF1o pero bien
        aprovechado."
      esEspecial: 0
  - idAdoptante: 02
    viveSolo: 0
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
        d\xEDa para cuidar al animal?"
      respuestaNPC: Tenemos bastante tiempo disponible, siempre hay alguien en casa
        dispuesto a hacerse cargo y cuidarlo como corresponde.
      esEspecial: 0
    - enunciadoPregunta: "\xBFHan tenido antes un animal con necesidades similares?"
      respuestaNPC: "Hemos tenido y cuidado animales anteriormente en casa, as\xED
        que no somos novatos en esto."
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal?"
      respuestaNPC: Nuestra casa cuenta con un patio amplio y seguro donde hay buen
        espacio.
      esEspecial: 0
  - idAdoptante: 03
    viveSolo: 1
    preguntas:
    - enunciadoPregunta: "\xBFAl vivir solo/a, cu\xE1nto tiempo sueles tener disponible
        durante el d\xEDa para cuidar al animal?"
      respuestaNPC: "\xA1Bastante! Al vivir solo maneja mis propios horarios y paso
        mucho tiempo en casa, as\xED que dispongo de tiempo alto para cuidarlo."
      esEspecial: 0
    - enunciadoPregunta: "\xBFHas tenido antes un animal con necesidades similares
        haci\xE9ndote cargo t\xFA solo/a?"
      respuestaNPC: "S\xED, he vivido con gatos antes. Me encantan y conozco perfecto
        sus cuidados e independencia."
      esEspecial: 0
    - enunciadoPregunta: "\xBFC\xF3mo es el espacio donde vivir\xEDa el animal siendo
        tu residencia \xFAnica?"
      respuestaNPC: Vivo en un departamento mediano, muy tranquilo, limpio y bien
        distribuido.
      esEspecial: 0
  - idAdoptante: 04
    viveSolo: 0
    preguntas:
    - enunciadoPregunta: "\xBFCu\xE1nto tiempo suelen tener disponible durante el
